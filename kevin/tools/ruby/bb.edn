{:paths ["src" "resources" "test" "property" "../core/src" "../core/property"]
 :tasks
 {test {:doc "Run the kevin-rb unit tests"
        :task (let [namespaces '[kevinrb.commands-test kevinrb.rubocop-test kevinrb.flog-test kevinrb.crap-test kevinrb.flay-test kevinrb.mutant-test kevinrb.cli-test]]
                (apply require 'clojure.test namespaces)
                (let [{:keys [fail error]} (apply clojure.test/run-tests namespaces)]
                  (System/exit (+ fail error))))}
  property {:doc "Run the kevin-rb property tests"
            :task (let [namespaces '[kevinrb.kevinrb-property]]
                    (apply require 'clojure.test namespaces)
                    (let [{:keys [fail error]} (apply clojure.test/run-tests namespaces)]
                      (System/exit (+ fail error))))}}}
