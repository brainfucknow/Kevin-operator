#!/usr/bin/env bash
# kevin-cs: C# tool wrapper for Kevin roles. See kevin/languages/csharp.md.
set -euo pipefail
command -v bb >/dev/null || { echo "kevin-cs: Babashka (bb) is required: https://babashka.org" >&2; exit 2; }
exec bb --config "$(cd "$(dirname "$0")/../tools/csharp" && pwd)/bb.edn" -m sfcs.cli "$@"
