#!/usr/bin/env bash
# kevin-cpp: C and C++ tool wrapper for Kevin roles. See kevin/languages/cpp.md.
set -euo pipefail
command -v bb >/dev/null || { echo "kevin-cpp: Babashka (bb) is required: https://babashka.org" >&2; exit 2; }
exec bb --config "$(cd "$(dirname "$0")/../tools/cpp" && pwd)/bb.edn" -m kevincpp.cli "$@"
