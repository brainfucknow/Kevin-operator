#!/usr/bin/env bash
# kevin-rb: Ruby tool wrapper for Kevin roles. See kevin/languages/ruby.md.
set -euo pipefail
command -v bb >/dev/null || { echo "kevin-rb: Babashka (bb) is required: https://babashka.org" >&2; exit 2; }
exec bb --config "$(cd "$(dirname "$0")/../tools/ruby" && pwd)/bb.edn" -m sfrb.cli "$@"
