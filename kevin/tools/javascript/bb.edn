{:paths ["src" "test" "property" "acceptance/src" "../core/src" "../core/test" "../core/property"]
 :tasks
 {test {:doc "Run the kevin-js unit tests"
        :task (let [namespaces '[kevinjs.package-test kevinjs.cli-test kevinjs.commands-test kevinjs.crap-test kevinjs.eslint-test kevinjs.oxlint-test kevinjs.mutate-test kevinjs.reports-test kevinjs.acceptance-test kevincore.architecture-test]]
                (apply require 'clojure.test namespaces)
                (let [{:keys [fail error]} (apply clojure.test/run-tests namespaces)]
                  (System/exit (+ fail error))))}
  property {:doc "Run the property tests of kevin-js and the shared core"
            :task (let [namespaces '[kevincore.core-property kevinjs.kevinjs-property]]
                    (apply require 'clojure.test namespaces)
                    (let [{:keys [fail error]} (apply clojure.test/run-tests namespaces)]
                      (System/exit (+ fail error))))}
  acceptance {:doc "Parse the kevin-js features, generate entry points, and run them; pass feature paths to run only those"
              :requires ([kevinjs.acceptance.pipeline :as pipeline])
              :task (apply pipeline/run *command-line-args*)}
  acceptance-worker {:doc "Persistent runner adapter for gherkin-mutator --runner-worker"
                     :requires ([kevinjs.acceptance.worker :as worker])
                     :task (worker/run)}}}
