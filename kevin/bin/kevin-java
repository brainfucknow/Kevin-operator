#!/usr/bin/env bash
# Java CLI: kevin/languages/java.md.
set -euo pipefail
command -v bb >/dev/null || { echo "kevin-java: Babashka (bb) is required" >&2; exit 2; }
here="$(cd "$(dirname "$0")/../tools/java" && pwd)"
exec bb -Dkevinjava.home="$here" -cp "$here/src:$here/resources:$here/../core/src" -m kevinjava.cli "$@"
